NODE_ENV=development
PORT=3001

# Copy the exact Direct connection string from Supabase Dashboard > Connect.
# This owner connection is used only by migrations and provisioning scripts.
# Never expose it to the frontend.
# Download the project CA from Database > Settings > SSL Configuration and
# save it as server/supabase-prod-ca-2021.crt.
DATABASE_MIGRATION_URL=postgresql://postgres:replace-with-database-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=./supabase-prod-ca-2021.crt

# After provisioning app_runtime_login, use its Direct connection string for
# the persistent NestJS API.
# Percent-encode reserved characters if the runtime password is placed in a URL.
DATABASE_URL=postgresql://app_runtime_login:replace-with-runtime-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=./supabase-prod-ca-2021.crt

# If the API host is IPv4-only, use Supavisor Session mode on port 5432:
# DATABASE_URL=postgresql://app_runtime_login.your-project-ref:replace-with-runtime-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=./supabase-prod-ca-2021.crt
# Do not use the transaction pooler on port 6543 for this API.
DATABASE_POOL_MAX=10

# Supabase Dashboard > Project Settings > Data API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Use the publishable key for passwordless retailer and staff invitations.
# Add the redirect URL to Supabase Auth > URL Configuration > Redirect URLs.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_INVITE_REDIRECT_URL=http://localhost:5173/accept-invitation


# Private Supabase Storage S3 credentials. These bypass Storage RLS and must
# only be used by the server, which enforces tenant-prefixed object keys.
SUPABASE_STORAGE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=your-project-region
SUPABASE_STORAGE_ACCESS_KEY_ID=replace-me
SUPABASE_STORAGE_SECRET_ACCESS_KEY=replace-me
SUPABASE_STORAGE_BUCKET=private-documents
# Create this bucket as public in Supabase Storage. Writes still use signed URLs.
SUPABASE_PRODUCT_IMAGE_BUCKET=product-images

# Didit hosted KYC workflow and signed webhook destination.
DIDIT_API_KEY=replace-me
DIDIT_WORKFLOW_ID=00000000-0000-4000-8000-000000000000
DIDIT_KYB_WORKFLOW_ID=00000000-0000-4000-8000-000000000000
DIDIT_WEBHOOK_SECRET=replace-with-at-least-16-characters
DIDIT_CALLBACK_URL=http://localhost:5173/onboarding
DIDIT_KYB_CALLBACK_URL=http://localhost:5173/business-profile
DIDIT_KYB_POLLING_FALLBACK_ENABLED=false
DIDIT_KYC_POLLING_FALLBACK_ENABLED=false
# RESEND_API_KEY=replace-with-a-sending-only-key
# NOTIFICATION_FROM_EMAIL=Investor Ready <notifications@example.com>
# NOTIFICATION_DATABASE_URL=postgresql://notification_worker_login:replace-me@db.project.supabase.co:5432/postgres?sslmode=verify-full

# First-party financed-device DPC enrollment and Ed25519 policy signing.
# Keep the PKCS8 private key only on the backend. The agent receives the matching public key.
# The APK URL must be HTTPS and the checksum must match the release-signing certificate.
# DPC_POLICY_PRIVATE_KEY_BASE64=base64-pkcs8-ed25519-private-key
# DPC_APK_DOWNLOAD_URL=https://downloads.example.com/finance-device-agent.apk
# DPC_APK_SIGNATURE_CHECKSUM=base64url-apk-signature-checksum
DPC_ENROLLMENT_TTL_MINUTES=15
DPC_POLICY_TTL_MINUTES=360
DPC_OFFLINE_GRACE_HOURS=48
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-firebase-service-account-json
PLAY_INTEGRITY_ENABLED=false
# PLAY_INTEGRITY_SERVICE_ACCOUNT_BASE64=base64-encoded-google-service-account-json
DPC_ANDROID_PACKAGE_NAME=com.eonpay.deviceagent

# Optional Esper tenant and Commands API credentials for legacy Esper-managed devices.
ESPER_TENANT_NAME=your-esper-tenant
ESPER_API_KEY=replace-me
ESPER_ENTERPRISE_ID=00000000-0000-4000-8000-000000000000

# Secrets used by the payment webhook gateway for HMAC-SHA256 verification.
MTN_MOMO_WEBHOOK_SECRET=replace-with-at-least-16-characters
ORANGE_MONEY_WEBHOOK_SECRET=replace-with-at-least-16-characters

# Comma-separated exact origins. Wildcards are intentionally unsupported.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
API_DOCS_ENABLED=true
